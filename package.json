{
  "name": "moneynest",
  "version": "1.0.3",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "release": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --clean --platform android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:push": "drizzle-kit push",
    "build:dev": "eas build --profile development --platform android",
    "build:prod": "eas build --profile production --platform android",
    "submit": "eas submit --platform android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-voice/voice": "^3.2.4",
    "@sentry/react-native": "~7.2.0",
    "@shopify/flash-list": "2.0.2",
    "@uginy/react-native-liquid-glass": "^1.2.6",
    "dayjs": "^1.11.0",
    "drizzle-orm": "^0.36.0",
    "expo": "~54.0.0",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "^8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "lucide-react-native": "^0.460.0",
    "nativewind": "^4.1.0",
    "posthog-react-native": "^3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-android-widget": "^0.15.0",
    "react-native-css-interop": "^0.2.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-gifted-charts": "^1.4.50",
    "react-native-mmkv": "^3.0.0",
    "react-native-quick-crypto": "^0.7.0",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "^0.5.1",
    "tailwindcss": "^3.4.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "@vitest/ui": "^2.1.0",
    "babel-preset-expo": "^55.0.22",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "typescript": "~5.6.0",
    "vitest": "^2.1.0"
  }
}
